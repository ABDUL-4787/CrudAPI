# PostgreSQL Database Configuration
DB_USER=postgres
DB_PASSWORD=secret_password_here
DB_NAME=todo_db

# JWT Authentication Config
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256

# Redis Cache Config
REDIS_HOST=cache
REDIS_PORT=6379

# Google Gemini LLM API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
